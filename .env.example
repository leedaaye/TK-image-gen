# Windows直接启动：DATABASE_URL留空/不设置时使用data/app.db（SQLite开发替代）
# DATABASE_URL=postgresql+psycopg://tk:password@127.0.0.1:5432/tk
PORT=8000
# 正式部署必须填写；密码仅首次初始化生效。数据库密码建议使用字母数字，避免URL转义问题。
POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
SECRET_KEY=replace_with_at_least_32_random_characters
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# HTTPS反向代理启用后改为true；HTTP本地测试使用false
COOKIE_SECURE=false
# 服务器默认仅本机监听，通过反向代理访问。直接局域网访问可改为0.0.0.0
BIND_ADDRESS=127.0.0.1
# 开发启动器可指定Node和pnpm脚本路径，未指定使用PATH内npm
# TK_NODE=C:\path\to\node.exe
# TK_PNPM=C:\path\to\pnpm.mjs
