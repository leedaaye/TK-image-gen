# ========================================================
# TikTok Carousel Generator 配置模板
# 复制本文件为 .env 并填入你的 API Key 即可独立运行
# ========================================================

# 1. 分析与策划模型 (需兼容 OpenAI chat/completions 接口，支持视觉看图能力)
ANALYSIS_BASE_URL=https://api.openai.com/v1
ANALYSIS_API_KEY=your_analysis_api_key_here
ANALYSIS_MODEL=gpt-4o

# 2. 生图模型 (需兼容 OpenAI images/edits 或 images/generations 接口)
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=your_image_api_key_here
IMAGE_MODEL=dall-e-3
# 生图模式: reference (使用参考图约束商品外观并绘制文字) 或 background (仅生成背景道具与文字)
IMAGE_MODE=reference
